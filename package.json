{
  "name": "fpl-lens",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "migrate:up": "cd server && npm run migrate:up",
    "migrate:down": "cd server && npm run migrate:down",
    "migrate:create": "cd server && npm run migrate:create",
    "ingest:dimensions": "cd server && npm run ingest:dimensions"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "chardet": "^2.2.0",
    "concurrently": "^8.2.2",
    "csv-parse": "^7.0.1",
    "tsx": "^4.23.1"
  }
}
