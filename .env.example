# Copy to .env. Read by docker-compose.yml and by the server (server/src/db).
#
# POSTGRES_PORT is the HOST port the container publishes. It defaults to 5434
# rather than 5432 to avoid clashing with a native Postgres install (5432) or
# other project containers (5433). If you change it, change the port in
# DATABASE_URL to match.

POSTGRES_USER=fpl
POSTGRES_PASSWORD=fpl
POSTGRES_DB=fpl_lens
POSTGRES_PORT=5434

DATABASE_URL=postgres://fpl:fpl@localhost:5434/fpl_lens
