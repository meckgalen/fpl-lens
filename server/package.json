{
  "name": "fpl-lens-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate:up": "node-pg-migrate --envPath ../.env up",
    "migrate:down": "node-pg-migrate --envPath ../.env down",
    "migrate:create": "node-pg-migrate --envPath ../.env --migration-file-language ts create",
    "ingest:dimensions": "tsx src/ingest/ingest-dimensions.ts",
    "ingest:fixtures": "tsx src/ingest/ingest-fixtures.ts",
    "ingest:gameweeks": "tsx src/ingest/ingest-gameweeks.ts",
    "ingest:live": "tsx src/ingest/ingest-live-season.ts",
    "ingest:live-gameweeks": "tsx src/ingest/ingest-live-gameweeks.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify:history-past": "tsx src/verify/history-past-check.ts",
    "verify:ppg": "tsx src/verify/ppg-check.ts",
    "verify:columns": "tsx src/verify/columns-check.ts",
    "verify:defcon": "tsx src/verify/defcon-check.ts",
    "verify:haul": "tsx src/verify/haul-check.ts",
    "verify:thresholds": "tsx src/verify/thresholds-check.ts"
  },
  "dependencies": {
    "@types/pg-copy-streams": "^1.2.5",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.2",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
