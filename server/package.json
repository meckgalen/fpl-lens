{
  "name": "fpl-lens-server",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:up": "node-pg-migrate --envPath ../.env up",
    "migrate:down": "node-pg-migrate --envPath ../.env down",
    "migrate:create": "node-pg-migrate --envPath ../.env --migration-file-language ts create",
    "ingest:dimensions": "tsx src/ingest/ingest-dimensions.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.2",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
